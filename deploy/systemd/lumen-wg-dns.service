[Unit]
Description=Lumen DNS for WireGuard devices (tunnel address only: the console's name, everything else forwarded)
Documentation=file://@LUMEN_REPO_DIR@/docs/operations/admin-guide.md
# Installed and enabled by deploy/lib/wireguard.sh once Lumen's wg0 is up. Started with wg0
# (WantedBy below), stopped and restarted with it (PartOf); dnsmasq binds the tunnel address,
# which exists only while wg0 is up, so it retries until then (Restart=always, no start limit).
After=wg-quick@wg0.service
PartOf=wg-quick@wg0.service
StartLimitIntervalSec=0

[Service]
Type=simple
# Only Lumen's file: listen-address=<tunnel address>, bind-interfaces, no hosts file, no DHCP.
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=@LUMEN_CONFIG_DIR@/wireguard/dnsmasq.conf --pid-file= --log-facility=-
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
# Hardening: dnsmasq binds port 53 as root, then switches to its unprivileged user.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=wg-quick@wg0.service
