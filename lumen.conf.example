# Lumen server configuration — copy to lumen.conf (or /etc/lumen/lumen.conf),
# edit, then:
#
#   sudo bash install.sh --config lumen.conf --yes     # first install, unattended
#   sudo ./lumenctl apply                              # after later edits
#
# Format: KEY=value, one per line, no quotes, no shell expansion.
# Secrets (SMTP password, Stripe keys, database passwords, signing keys) never go
# in this file. The installer generates internal secrets and asks for external
# ones with hidden prompts; they live in /etc/lumen/secrets (root-only, 0440/0400).
# See docs/operations/admin-guide.md for every setting in context.

# --- Domains (required) --------------------------------------------------------
# Website, customer portal and Matrix server name (users become @name:example.com).
LUMEN_PRIMARY_DOMAIN=example.com
# Optional overrides; defaults shown.
#LUMEN_APP_DOMAIN=app.example.com          # web chat app
#LUMEN_MATRIX_DOMAIN=matrix.example.com    # homeserver (client + federation API on 443)
#LUMEN_OPS_DOMAIN=ops.example.com          # operator console (private, see below)
#LUMEN_OPS_PORT=8443
#MATRIX_SERVER_NAME=example.com            # cannot be changed after the first user exists

# Contact for TLS certificate notices (Let's Encrypt) and the first operator.
ADMIN_EMAIL=admin@example.com

# --- First operator ----------------------------------------------------------------
# Username for the first operator-console account. The installer prints a one-time
# setup link (also saved root-only to /etc/lumen/operator-setup-link.txt); the
# operator sets a password and must enrol MFA. No default password exists.
OPERATOR_USERNAME=admin

# --- TLS ------------------------------------------------------------------------------
# acme: public certificates from Let's Encrypt (DNS must point here, ports 80/443 open).
# internal: Caddy's own CA — test labs only; browsers and other servers won't trust it.
TLS_MODE=acme
#ACME_CA=                                   # alternative ACME directory URL
#OPS_TLS_MODE=                              # defaults to TLS_MODE

# --- Operator console access --------------------------------------------------------
# The console listens on ops.<domain>:8443 and only accepts connections from
# localhost (SSH tunnel) and the WireGuard subnet. Add extra source networks here
# only if you understand the exposure (comma-separated CIDRs).
#ADMIN_ALLOWED_CIDRS=

# --- Accounts ----------------------------------------------------------------------
# open: anyone may sign up · invite: only people with a workspace invitation · closed
REGISTRATION_MODE=open

# --- Federation ----------------------------------------------------------------------
# open: talk to any Matrix server · allowlist: only FEDERATION_ALLOWLIST · closed: none
FEDERATION_MODE=open
#FEDERATION_ALLOWLIST=partner.example,matrix.org
# Server used to check that the rest of the network can reach you (key notary).
# Defaults to matrix.org when federation is open; "none" disables the external check.
#FEDERATION_PROBE_NOTARY=
#TRUSTED_KEY_SERVERS=matrix.org

# --- Features --------------------------------------------------------------------------
PRESENCE_ENABLED=true

# --- Voice and video calls (on by default) --------------------------------------------
# MatrixRTC calls through a LiveKit SFU with end-to-end encrypted media (the SFU only
# forwards ciphertext). Needs a DNS name for the SFU and these ports open in UFW AND in
# any cloud-provider firewall: 7882-7889/udp (media), 7881/tcp (ICE/TCP fallback),
# 3478/udp (TURN), 5349/tcp (TURN/TLS). See docs/operations/admin-guide.md#calls.
CALLS_ENABLED=true
#LUMEN_RTC_DOMAIN=rtc.example.com           # SFU signalling + TURN/TLS certificate name
#CALLS_PUBLIC_IP=                           # public IPv4 the SFU advertises (empty: LiveKit asks public STUN servers at startup)
#CALLS_UDP_PORTS=7882-7889                  # ICE/UDP mux range (at most 64 ports)
#CALLS_TCP_PORT=7881
#CALLS_TURN_UDP_PORT=3478
#CALLS_TURN_TLS_PORT=5349
#CALLS_MAX_PARTICIPANTS=0                   # per call; 0 = no limit (capacity depends on the host)
#RTC_NETWORK_SUBNET=172.30.42.0/28          # internal Docker network for SFU administration
# Test labs only: let the SFU advertise a private address (e.g. 10.200.0.1).
#CALLS_ALLOW_PRIVATE_NODE_IP=false

# --- Mobile and desktop apps ------------------------------------------------------------
# The Windows, macOS, Android and iOS apps discover everything from this server's
# /.well-known/matrix/client (see docs/apps/integration.md); nothing here is secret.
#APP_URL_SCHEME=io.lumen.secure            # SSO return + deep links (must match the apps' build)
# Verified app links (https://app.<domain>/... opens the app) — from YOUR signed builds:
#APP_LINKS_ANDROID_PACKAGE=io.lumen.secure
#APP_LINKS_ANDROID_SHA256=                  # signing-certificate SHA-256 fingerprint(s), AA:BB:...
#APP_LINKS_APPLE_BUNDLE_ID=io.lumen.secure
#APP_LINKS_APPLE_TEAM_ID=                   # your 10-character Apple team ID

# --- Push notifications for the mobile apps (optional) --------------------------------------
# Synapse -> Sygnal push gateway (on this server) -> Firebase Cloud Messaging / Apple Push.
# Pushes carry only room and event IDs plus unread counts; the apps fetch and decrypt the
# message themselves. Google/Apple still learn that a user received something, and when.
# Credentials (never in this file):
#   sudo ./lumenctl set-secret push_fcm_service_account < firebase-service-account.json
#   sudo ./lumenctl set-secret push_apns_key < AuthKey_XXXXXXXXXX.p8
PUSH_ENABLED=false
#PUSH_FCM_PROJECT_ID=                       # Firebase project of YOUR Android build
#PUSH_APNS_TEAM_ID=                         # Apple team ID
#PUSH_APNS_KEY_ID=                          # APNs auth key ID
#PUSH_APNS_TOPIC=                           # default: APP_LINKS_APPLE_BUNDLE_ID
#PUSH_APNS_SANDBOX=false                    # true only for development builds run from Xcode (TestFlight and App Store use production)
#PUSH_PORT=5000                             # 127.0.0.1 only

# --- WireGuard (optional private admin network; never replaces end-to-end encryption)
WIREGUARD_ENABLED=false
#WG_SUBNET=10.77.0.0/24
#WG_PORT=51820

# --- Email (optional) -----------------------------------------------------------------
# Without SMTP: no email verification or password reset by email; operators can issue
# one-time recovery links instead. The SMTP password is asked for during install.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=lumen@example.com
#SMTP_SECURITY=starttls                     # starttls | tls | none
#SMTP_FROM=Lumen <no-reply@example.com>

# --- Billing -----------------------------------------------------------------------------
# none: everyone is on the Free plan · manual: operators assign plans · stripe: Checkout +
# Customer Portal (secret key and webhook secret are asked for during install; price IDs
# are set per plan in the operator console). Payments are never simulated.
BILLING_PROVIDER=none
#BILLING_CURRENCY=usd
#BILLING_GRACE_DAYS=14
#STRIPE_PUBLISHABLE_KEY=pk_live_...

# --- Branding ----------------------------------------------------------------------------
BRAND_NAME=Lumen Secure
BRAND_SHORT_NAME=Lumen
#BRAND_TAGLINE=Private conversations on an open, federated network.
# Legal entity shown in the footer, terms and privacy policy. Review those pages
# with counsel before going live.
BRAND_LEGAL_NAME=Example Ltd
#BRAND_JURISDICTION=
#SUPPORT_EMAIL=support@example.com
#SECURITY_EMAIL=security@example.com        # published in /.well-known/security.txt
#PRIVACY_EMAIL=privacy@example.com
#PUBLIC_STATUS_PAGE=true
# Logo/colours: put logo.svg, favicon.svg and theme.css in /etc/lumen/branding.

# --- Host management ----------------------------------------------------------------------
# yes: add UFW rules for 22/80/443 (+ TURN, WireGuard) — existing rules are kept,
# SSH stays allowed. no: you manage the firewall yourself.
FIREWALL_MANAGE=yes
UNATTENDED_UPGRADES=yes

# --- Backups ---------------------------------------------------------------------------------
# Daily encrypted (age) backups of databases, media, signing keys and configuration.
#BACKUP_DIR=/var/backups/lumen
#BACKUP_SCHEDULE=03:17                      # local time
#BACKUP_KEEP_DAILY=7
#BACKUP_KEEP_WEEKLY=4
# Off-site copy with rsync over SSH (key: /etc/lumen/backup/ssh_key). Strongly recommended.
#BACKUP_REMOTE=backup@backup.example.net:/srv/lumen-backups

# --- Advanced ----------------------------------------------------------------------------------
#DEFAULT_MAX_UPLOAD_MB=1024                 # homeserver ceiling; plans set the real limits
#LOG_LEVEL=INFO
#LUMEN_DATA_DIR=/var/lib/lumen
#LUMEN_CONFIG_DIR=/etc/lumen
#POSTGRES_SHARED_BUFFERS=                   # auto-sized from RAM
# Only for networks that intercept TLS: extra CA bundle used while building images.
#LUMEN_BUILD_EXTRA_CA=
