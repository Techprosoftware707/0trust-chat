{
  "name": "lumen-chat",
  "private": true,
  "version": "1.0.0",
  "description": "Lumen Secure web chat client (Matrix, end-to-end encrypted)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:e2ee": "node --test --test-force-exit --test-reporter=spec ../../tests/chat/e2ee.test.mjs",
    "test:ui": "npm run build && node --test --test-force-exit --test-concurrency=1 --test-reporter=spec ../../tests/chat/ui.test.mjs",
    "devserver:up": "node ../../tests/chat/devserver.mjs up",
    "devserver:down": "node ../../tests/chat/devserver.mjs down",
    "test:calls": "node ../../tests/calls/run.mjs",
    "test:sso": "npm run build && node ../../tests/chat/sso.smoke.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "livekit-client": "2.22.4",
    "loglevel": "^1.9.2",
    "lucide-react": "^1.57.0",
    "matrix-encrypt-attachment": "^1.0.3",
    "matrix-js-sdk": "^44.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
