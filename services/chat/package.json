{
  "name": "lumen-chat",
  "private": true,
  "version": "1.0.0",
  "description": "Lumen Secure web chat client (Matrix, end-to-end encrypted)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:e2ee": "node --test ../../tests/chat/e2ee.test.mjs",
    "test:ui": "node ../../tests/chat/run-ui-tests.mjs",
    "devserver:up": "node ../../tests/chat/devserver.mjs up",
    "devserver:down": "node ../../tests/chat/devserver.mjs down"
  },
  "dependencies": {
    "loglevel": "^1.9.2",
    "lucide-react": "^1.57.0",
    "matrix-encrypt-attachment": "^1.0.3",
    "matrix-js-sdk": "^44.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
