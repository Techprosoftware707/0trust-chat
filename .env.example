# .env.example — for reference only.
#
# Lumen does not read a .env file. Your settings go in lumen.conf (see
# lumen.conf.example); install.sh / `lumenctl apply` render them into
# /etc/lumen/rendered/compose.env, which `lumenctl compose ...` passes to
# Docker Compose together with docker-compose.yml. Secrets are never in this
# environment: they are files in /etc/lumen/secrets mounted as Compose secrets.
#
# If you run `docker compose` by hand, use the generated file instead of this one:
#   sudo ./lumenctl compose ps          # recommended
#   docker compose --env-file /etc/lumen/rendered/compose.env -p lumen ps
#
# The variables docker-compose.yml expects, with the values a default install
# for example.com would generate:
COMPOSE_PROJECT_NAME=lumen
LUMEN_REPO_DIR=/opt/lumen
LUMEN_CONFIG_DIR=/etc/lumen
LUMEN_DATA_DIR=/var/lib/lumen
LUMEN_SOCKET_DIR=/var/lib/lumen/sockets
LUMEN_RENDERED_DIR=/etc/lumen/rendered
LUMEN_SECRETS_DIR=/etc/lumen/secrets
LUMEN_BRANDING_DIR=/etc/lumen/branding
LUMEN_CHAT_DIST=/var/lib/lumen/www/chat
LUMEN_WWW_DIR=/var/lib/lumen/www
LUMEN_STATUS_DIR=/var/lib/lumen/status
LUMEN_AGENT_DIR=/run/lumen-agent
LUMEN_PRIMARY_DOMAIN=example.com
LUMEN_APP_DOMAIN=app.example.com
LUMEN_MATRIX_DOMAIN=matrix.example.com
LUMEN_OPS_DOMAIN=ops.example.com
LUMEN_OPS_PORT=8443
MATRIX_SERVER_NAME=example.com
EXTRA_HOSTS_IP=host-gateway
# With TLS_MODE=internal (labs only): CA_BUNDLE_HOST_PATH=/etc/lumen/ca/bundle.crt
CA_BUNDLE_HOST_PATH=/dev/null
LUMEN_VERSION=1.0.0
UID_APP=10001
UID_CADDY=10200
GID_SECRETS=10100
GID_SOCKETS=10300
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
SYNAPSE_IMAGE=ghcr.io/element-hq/synapse:v1.163.0@sha256:e98ab72138d90fa8b8876c6421fe78a9fdb181c0d7cc690ad740e5173e0c65e6
CADDY_IMAGE=caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
COTURN_IMAGE=coturn/coturn:4.18.0-alpine@sha256:c29135c08565810d37053f384584392b7c24b69570fc81a721b878d6fe63e04e
POSTGRES_IMAGE=postgres:17.11-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
PYTHON_BASE_IMAGE=python:3.13-slim-trixie@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f
NODE_BASE_IMAGE=node:24-trixie-slim@sha256:7f486cabe892bff8fef04c0f7da8dba84a560be3e4e2740b7a86afc57ebec315
PORTAL_IMAGE=lumen/portal:1.0.0
# Only with TLS_MODE=internal (labs): SYNAPSE_SSL_CERT_FILE=/etc/lumen-ca/ca.crt
