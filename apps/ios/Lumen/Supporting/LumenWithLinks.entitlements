<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Lumen.entitlements plus universal links. Select it with
     LUMEN_ENTITLEMENTS_FILE=LumenWithLinks.entitlements LUMEN_ASSOCIATED_DOMAIN=app.example.com
     (the server must serve apple-app-site-association: APP_LINKS_APPLE_TEAM_ID in lumen.conf). -->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>$(LUMEN_APS_ENVIRONMENT)</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(LUMEN_APP_GROUP)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(LUMEN_BUNDLE_ID)</string>
	</array>
	<key>com.apple.developer.default-data-protection</key>
	<string>NSFileProtectionCompleteUntilFirstUserAuthentication</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(LUMEN_ASSOCIATED_DOMAIN)</string>
	</array>
</dict>
</plist>
