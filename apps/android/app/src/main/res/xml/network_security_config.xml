<?xml version="1.0" encoding="utf-8"?>
<!-- Release: https only, system trust anchors only (no user-installed CAs), no cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
